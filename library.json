{
  "name": "RCLink",
  "version": "1.4.1",
  "description": "Validated Arduino RC receiver mapping with portable iBUS, ESP32 SBUS, shaping, filtering, channel health, and failsafe handling.",
  "keywords": [
    "rc",
    "ibus",
    "sbus",
    "receiver",
    "failsafe",
    "esp32",
    "arduino"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/littlemanbuilds/RCLink"
  },
  "homepage": "https://github.com/littlemanbuilds/RCLink",
  "authors": [
    {
      "name": "Little Man Builds (Darren Osborne)",
      "email": "littlemanbuilds@gmail.com",
      "maintainer": true
    }
  ],
  "frameworks": [
    "arduino"
  ],
  "headers": "RCLink.h",
  "platforms": [
    "atmelsam",
    "espressif32",
    "espressif8266",
    "raspberrypi",
    "ststm32",
    "teensy"
  ],
  "examples": [
    "examples/01_BasicIbusLink/01_BasicIbusLink.ino",
    "examples/02_IbusCalibration/02_IbusCalibration.ino",
    "examples/03_SbusCalibration/03_SbusCalibration.ino",
    "examples/04_FlyskyFSi6XDemo/04_FlyskyFSi6XDemo.ino",
    "examples/05_JsonConfigDemo/05_JsonConfigDemo.ino",
    "examples/06_AdvancedFeatureDemo/06_AdvancedFeatureDemo.ino"
  ],
  "export": {
    "include": [
      ".github/workflows/ci.yml",
      "CHANGELOG.md",
      "LICENSE",
      "README.md",
      "RELEASE_CHECKLIST.md",
      "examples/01_BasicIbusLink/01_BasicIbusLink.ino",
      "examples/02_IbusCalibration/02_IbusCalibration.ino",
      "examples/03_SbusCalibration/03_SbusCalibration.ino",
      "examples/04_FlyskyFSi6XDemo/04_FlyskyFSi6XDemo.ino",
      "examples/05_JsonConfigDemo/05_JsonConfigDemo.ino",
      "examples/06_AdvancedFeatureDemo/06_AdvancedFeatureDemo.ino",
      "keywords.txt",
      "library.json",
      "library.properties",
      "platformio.ini",
      "src/Config.hpp",
      "src/Constants.hpp",
      "src/Json.hpp",
      "src/Link.hpp",
      "src/RCLink.h",
      "src/RcMacros.hpp",
      "src/Types.hpp",
      "src/calibration/Ibus_Calibrate.hpp",
      "src/calibration/Sbus_Calibrate.hpp",
      "src/calibration/detail/Calibrate.hpp",
      "src/transport/Ibus.hpp",
      "src/transport/Sbus_Esp32.hpp",
      "src/transport/detail/IbusDecoder.hpp",
      "src/transport/detail/SbusDecoder.hpp",
      "test/README.md",
      "test/build_platformio_consumer.py",
      "test/capture_sbus.py",
      "test/check_distribution.sh",
      "test/check_release_contracts.sh",
      "test/native/arduino_stub/Arduino.h",
      "test/native/calibration_compat.cpp",
      "test/native/calibration_stub/Arduino.h",
      "test/native/test_calibration.cpp",
      "test/native/test_corrective.cpp",
      "test/native/test_json.cpp",
      "test/native/test_rclink.cpp",
      "test/native/test_sbus.cpp",
      "test/native/test_sbus_calibration.cpp",
      "test/native/v1_1_compat.cpp",
      "test/pack_release.py",
      "test/portable_compile/portable_compile.ino",
      "test/run_helper_tests.sh",
      "test/run_host_checks.sh",
      "test/run_native_tests.sh",
      "test/run_sanitizers.sh",
      "test/sbus_diagnostic/README.md",
      "test/sbus_diagnostic/SbusDiagnostic.ino",
      "test/test_capture_sbus.py"
    ]
  },
  "dependencies": [
    {
      "name": "ArduinoJson",
      "owner": "bblanchon",
      "version": "^7.4.2",
      "frameworks": [
        "arduino"
      ]
    }
  ],
  "license": "MIT",
  "build": {
    "includeDir": "src"
  }
}
